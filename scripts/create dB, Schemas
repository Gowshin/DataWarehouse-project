/*
This code is to create new database: DataWarehouse, and three schemas namely Bronze, Silver and Gold.
Running this code can result in deletion of previous data in the dB if it already exists.
*/

USE master;
GO

IF EXISTS (SELECT 1 FROM sys.databases WHERE name= 'DataWarehouse')
BEGIN
  ALTER DATABASE DataWarehouse SET SINGLE_USER WITH ROLLBACK IMMEDIATE;
  DROP DATABASE DataWarehouse;
END;
GO

-- Database creation
CREATE DATABASE DataWarehouse;
GO

USE DataWarehouse;
GO

-- Schema creation
CREATE SCHEMA Bronze;
GO

CREATE SCHEMA Silver;
GO

CREATE SCHEMA Gold;
GO
